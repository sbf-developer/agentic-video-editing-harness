# Copy this file to apps/studio/.env and add your DeepSeek API key.
# .env is gitignored — your key will never be pushed to the repo.
#
# With the key set, the AI Editor can:
# - Cut, trim, reorder clips
# - Add text overlays
# - Set transitions, music, voiceover
# - Reframe/zoom individual clips
#
DEEPSEEK_API_KEY=sk-your-key-here
